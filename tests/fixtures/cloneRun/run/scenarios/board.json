{
  "start_path": "/",
  "actions": [
    {
      "step_id": "fp-topics",
      "action": "request",
      "method": "GET",
      "path": "/api/topics",
      "timeout_ms": 15000
    },
    {
      "step_id": "where-page",
      "action": "goto",
      "destination": {
        "url": "{origin}/where"
      },
      "wait_until": "load",
      "timeout_ms": 15000
    },
    {
      "step_id": "board-facts",
      "action": "request",
      "method": "GET",
      "path": "/api/board",
      "timeout_ms": 15000
    }
  ]
}
