{
  "version": 3,
  "sources": ["../../src/jsapp/src/api.js", "../../src/jsapp/src/store.js", "../../src/jsapp/src/main.js"],
  "sourcesContent": ["const BASE = \"/api\";\nexport async function listTopics(query) {\n  const response = await fetch(`${BASE}/topics?q=${encodeURIComponent(query || \"\")}`);\n  if (!response.ok) throw new Error(`list failed: ${response.status}`);\n  return response.json();\n}\nexport async function createTopic(title) {\n  const response = await fetch(`${BASE}/topics`, { method: \"POST\", headers: { \"content-type\": \"application/json\" }, body: JSON.stringify({ title }) });\n  return { status: response.status, body: await response.json() };\n}\nexport async function deleteTopic(id) {\n  const response = await fetch(`${BASE}/topics/${id}`, { method: \"DELETE\" });\n  return response.status === 204 || response.ok;\n}\nexport function openSocket(onMessage) {\n  const socket = new WebSocket(`ws://${location.host}/live`);\n  socket.addEventListener(\"message\", (event) => onMessage(JSON.parse(event.data)));\n  return socket;\n}\n", "import { listTopics, createTopic, deleteTopic } from \"./api.js\";\nconst KEY = \"census.topics.cache\";\nexport class TopicStore {\n  constructor() { this.items = []; this.listeners = new Set(); }\n  subscribe(listener) { this.listeners.add(listener); return () => this.listeners.delete(listener); }\n  emit() { for (const listener of this.listeners) listener(this.items); localStorage.setItem(KEY, JSON.stringify(this.items)); }\n  async refresh(query) { const { items } = await listTopics(query); this.items = items; this.emit(); }\n  async add(title) {\n    const trimmed = title.trim().replace(/\\s+/g, \" \");\n    if (trimmed.length < 3 || trimmed.length > 48) return { ok: false, reason: \"title_length\" };\n    const { status, body } = await createTopic(trimmed);\n    if (status === 409) return { ok: false, reason: \"title_taken\", id: body.id };\n    if (status !== 201) return { ok: false, reason: body.error || \"unknown\" };\n    this.items = [...this.items, body]; this.emit(); return { ok: true, topic: body };\n  }\n  async remove(id) { if (await deleteTopic(id)) { this.items = this.items.filter((item) => item.id !== id); this.emit(); return true; } return false; }\n}\nexport function slugFor(title) {\n  const base = title.toLowerCase().replace(/[^a-z0-9]+/g, \"-\").replace(/^-+|-+$/g, \"\").slice(0, 24) || \"topic\";\n  return base;\n}\n", "import { TopicStore, slugFor } from \"./store.js\";\nimport { openSocket } from \"./api.js\";\nconst store = new TopicStore();\nconst list = document.querySelector(\"#topics\");\nconst form = document.querySelector(\"#new-topic\");\nconst status = document.querySelector(\"#status\");\nfunction render(items) {\n  list.replaceChildren(...items.map((item) => {\n    const li = document.createElement(\"li\");\n    li.dataset.id = String(item.id);\n    li.textContent = `${item.pinned ? \"[pinned] \" : \"\"}${item.title} (${item.slug || slugFor(item.title)})`;\n    const button = document.createElement(\"button\");\n    button.textContent = \"Delete\";\n    button.addEventListener(\"click\", async () => { status.textContent = (await store.remove(item.id)) ? \"Deleted\" : \"Cannot delete\"; });\n    li.append(button);\n    return li;\n  }));\n}\nstore.subscribe(render);\nform.addEventListener(\"submit\", async (event) => {\n  event.preventDefault();\n  const result = await store.add(new FormData(form).get(\"title\"));\n  status.textContent = result.ok ? `Created ${result.topic.slug}` : `Refused: ${result.reason}`;\n});\nwindow.addEventListener(\"message\", (event) => { if (event.origin === location.origin && event.data?.type === \"refresh\") store.refresh(\"\"); });\nopenSocket((message) => { if (message.kind === \"changed\") store.refresh(\"\"); });\nstore.refresh(new URLSearchParams(location.search).get(\"q\"));\n"],
  "mappings": "MAAA,IAAMA,EAAO,OACb,eAAsBC,EAAWC,EAAO,CACtC,IAAMC,EAAW,MAAM,MAAM,GAAGH,CAAI,aAAa,mBAAmBE,GAAS,EAAE,CAAC,EAAE,EAClF,GAAI,CAACC,EAAS,GAAI,MAAM,IAAI,MAAM,gBAAgBA,EAAS,MAAM,EAAE,EACnE,OAAOA,EAAS,KAAK,CACvB,CACA,eAAsBC,EAAYC,EAAO,CACvC,IAAMF,EAAW,MAAM,MAAM,GAAGH,CAAI,UAAW,CAAE,OAAQ,OAAQ,QAAS,CAAE,eAAgB,kBAAmB,EAAG,KAAM,KAAK,UAAU,CAAE,MAAAK,CAAM,CAAC,CAAE,CAAC,EACnJ,MAAO,CAAE,OAAQF,EAAS,OAAQ,KAAM,MAAMA,EAAS,KAAK,CAAE,CAChE,CACA,eAAsBG,EAAYC,EAAI,CACpC,IAAMJ,EAAW,MAAM,MAAM,GAAGH,CAAI,WAAWO,CAAE,GAAI,CAAE,OAAQ,QAAS,CAAC,EACzE,OAAOJ,EAAS,SAAW,KAAOA,EAAS,EAC7C,CACO,SAASK,EAAWC,EAAW,CACpC,IAAMC,EAAS,IAAI,UAAU,QAAQ,SAAS,IAAI,OAAO,EACzD,OAAAA,EAAO,iBAAiB,UAAYC,GAAUF,EAAU,KAAK,MAAME,EAAM,IAAI,CAAC,CAAC,EACxED,CACT,CCjBA,IAAME,EAAM,sBACCC,EAAN,KAAiB,CACtB,aAAc,CAAE,KAAK,MAAQ,CAAC,EAAG,KAAK,UAAY,IAAI,GAAO,CAC7D,UAAUC,EAAU,CAAE,YAAK,UAAU,IAAIA,CAAQ,EAAU,IAAM,KAAK,UAAU,OAAOA,CAAQ,CAAG,CAClG,MAAO,CAAE,QAAWA,KAAY,KAAK,UAAWA,EAAS,KAAK,KAAK,EAAG,aAAa,QAAQF,EAAK,KAAK,UAAU,KAAK,KAAK,CAAC,CAAG,CAC7H,MAAM,QAAQG,EAAO,CAAE,GAAM,CAAE,MAAAC,CAAM,EAAI,MAAMC,EAAWF,CAAK,EAAG,KAAK,MAAQC,EAAO,KAAK,KAAK,CAAG,CACnG,MAAM,IAAIE,EAAO,CACf,IAAMC,EAAUD,EAAM,KAAK,EAAE,QAAQ,OAAQ,GAAG,EAChD,GAAIC,EAAQ,OAAS,GAAKA,EAAQ,OAAS,GAAI,MAAO,CAAE,GAAI,GAAO,OAAQ,cAAe,EAC1F,GAAM,CAAE,OAAAC,EAAQ,KAAAC,CAAK,EAAI,MAAMC,EAAYH,CAAO,EAClD,OAAIC,IAAW,IAAY,CAAE,GAAI,GAAO,OAAQ,cAAe,GAAIC,EAAK,EAAG,EACvED,IAAW,IAAY,CAAE,GAAI,GAAO,OAAQC,EAAK,OAAS,SAAU,GACxE,KAAK,MAAQ,CAAC,GAAG,KAAK,MAAOA,CAAI,EAAG,KAAK,KAAK,EAAU,CAAE,GAAI,GAAM,MAAOA,CAAK,EAClF,CACA,MAAM,OAAOE,EAAI,CAAE,OAAI,MAAMC,EAAYD,CAAE,GAAK,KAAK,MAAQ,KAAK,MAAM,OAAQE,GAASA,EAAK,KAAOF,CAAE,EAAG,KAAK,KAAK,EAAU,IAAe,EAAO,CACtJ,EACO,SAASG,EAAQR,EAAO,CAE7B,OADaA,EAAM,YAAY,EAAE,QAAQ,cAAe,GAAG,EAAE,QAAQ,WAAY,EAAE,EAAE,MAAM,EAAG,EAAE,GAAK,OAEvG,CClBA,IAAMS,EAAQ,IAAIC,EACZC,EAAO,SAAS,cAAc,SAAS,EACvCC,EAAO,SAAS,cAAc,YAAY,EAC1CC,EAAS,SAAS,cAAc,SAAS,EAC/C,SAASC,EAAOC,EAAO,CACrBJ,EAAK,gBAAgB,GAAGI,EAAM,IAAKC,GAAS,CAC1C,IAAMC,EAAK,SAAS,cAAc,IAAI,EACtCA,EAAG,QAAQ,GAAK,OAAOD,EAAK,EAAE,EAC9BC,EAAG,YAAc,GAAGD,EAAK,OAAS,YAAc,EAAE,GAAGA,EAAK,KAAK,KAAKA,EAAK,MAAQE,EAAQF,EAAK,KAAK,CAAC,IACpG,IAAMG,EAAS,SAAS,cAAc,QAAQ,EAC9C,OAAAA,EAAO,YAAc,SACrBA,EAAO,iBAAiB,QAAS,SAAY,CAAEN,EAAO,YAAe,MAAMJ,EAAM,OAAOO,EAAK,EAAE,EAAK,UAAY,eAAiB,CAAC,EAClIC,EAAG,OAAOE,CAAM,EACTF,CACT,CAAC,CAAC,CACJ,CACAR,EAAM,UAAUK,CAAM,EACtBF,EAAK,iBAAiB,SAAU,MAAOQ,GAAU,CAC/CA,EAAM,eAAe,EACrB,IAAMC,EAAS,MAAMZ,EAAM,IAAI,IAAI,SAASG,CAAI,EAAE,IAAI,OAAO,CAAC,EAC9DC,EAAO,YAAcQ,EAAO,GAAK,WAAWA,EAAO,MAAM,IAAI,GAAK,YAAYA,EAAO,MAAM,EAC7F,CAAC,EACD,OAAO,iBAAiB,UAAYD,GAAU,CAAMA,EAAM,SAAW,SAAS,QAAUA,EAAM,MAAM,OAAS,WAAWX,EAAM,QAAQ,EAAE,CAAG,CAAC,EAC5Ia,EAAYC,GAAY,CAAMA,EAAQ,OAAS,WAAWd,EAAM,QAAQ,EAAE,CAAG,CAAC,EAC9EA,EAAM,QAAQ,IAAI,gBAAgB,SAAS,MAAM,EAAE,IAAI,GAAG,CAAC",
